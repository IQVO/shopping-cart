    "description": "List the carts of one shopper, newest first, optionally of one state (OPEN, CHECKED_OUT, ABANDONED or MERGED). Each entry is the same document get_cart returns. Answers ONE page of at most limit carts (1 to 100, default 20) and hasMore says an older cart exists; narrow with state to reach it. A shopper with no carts gets an empty list, not an error. Read-only; a missing or invalid shopperId, an unknown state or a limit out of range fails with validation-failed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "optional page size from 1 to 100; omitted means 20",
          "type": "integer"
        },
        "shopperId": {
          "description": "the shopper id whose carts are listed, e.g. shopper-42",
          "type": "string"
        },
        "state": {
          "description": "optional state filter: OPEN, CHECKED_OUT, ABANDONED or MERGED; omitted means every state",
          "type": "string"
        }
      },
      "required": [
        "shopperId"
      ],
      "type": "object"
    },
